# Application
APP_ENV=development
DEBUG=false

# PostgreSQL (local Docker Compose)
POSTGRES_DB=vietnamquoctu
POSTGRES_USER=app
POSTGRES_PASSWORD=local-dev-only-change-me
DATABASE_URL=postgresql+psycopg://app:local-dev-only-change-me@localhost:5432/vietnamquoctu

# Use unique random values of at least 32 characters outside local development.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-another-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Files and public QR-code links
MEDIA_STORAGE_PATH=./var/media
PUBLIC_BASE_URL=http://localhost:8000
REFRESH_COOKIE_SECURE=false

# Set all three values to create the first SUPER_ADMIN on startup.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password